<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="app.duck.notes.test.READ_IMAGES" android:protectionLevel="signature" />
    <uses-permission android:name="app.duck.notes.test.READ_IMAGES" />
    <application>
        <activity
            android:name="app.duck.notes.data.repository.ShareReceiverActivity"
            android:label="Duck Notes transfer test"
            android:exported="true"
            android:process=":share_receiver">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <activity
            android:name="app.duck.notes.settings.PauseOnlyOverlayActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <provider
            android:name="app.duck.notes.data.repository.TransferDocumentProvider"
            android:authorities="app.duck.notes.test.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:readPermission="app.duck.notes.test.READ_IMAGES"
            android:process=":documents">
            <path-permission android:pathPrefix="/" android:writePermission="app.duck.notes.test.READ_IMAGES" />
        </provider>
        <provider
            android:name="app.duck.notes.data.repository.ImageSourceProvider"
            android:authorities="app.duck.notes.test.images"
            android:exported="true"
            android:grantUriPermissions="true"
            android:readPermission="app.duck.notes.test.READ_IMAGES"
            android:process=":image_source" />
    </application>
    <instrumentation
        android:name="app.duck.notes.settings.SettingsTestRunner"
        android:targetPackage="app.duck.notes"
        android:functionalTest="false"
        android:handleProfiling="false" />
    <instrumentation
        android:name="app.duck.notes.startup.OfflineActivityTestRunner"
        android:targetPackage="app.duck.notes"
        android:functionalTest="false"
        android:handleProfiling="false" />
    <instrumentation
        android:name="app.duck.notes.data.repository.BackupTransportTestRunner"
        android:targetPackage="app.duck.notes"
        android:functionalTest="false"
        android:handleProfiling="false" />
    <instrumentation
        android:name="app.duck.notes.startup.WelcomeStartupTestRunner"
        android:targetPackage="app.duck.notes"
        android:functionalTest="false"
        android:handleProfiling="false" />
    <instrumentation
        android:name="app.duck.notes.startup.WelcomeExistingInstallTestRunner"
        android:targetPackage="app.duck.notes"
        android:functionalTest="false"
        android:handleProfiling="false" />
    <instrumentation
        android:name="app.duck.notes.qualification.ReleaseProbeRunner"
        android:targetPackage="app.duck.notes"
        android:functionalTest="false"
        android:handleProfiling="false" />
    <instrumentation
        android:name="androidx.test.runner.AndroidJUnitRunner"
        android:targetPackage="app.duck.notes"
        android:functionalTest="false"
        android:handleProfiling="false" />
</manifest>
