    <!--
      Phase 8c format toolbar. These are the buttons' contentDescription, so they are read aloud and
      have to name the action rather than the glyph — "Bullet list", not "Dots".
    -->
    <string name="format_bold">Bold</string>
    <string name="format_italic">Italic</string>
    <string name="format_code">Code</string>
    <string name="format_highlight">Highlight</string>
    <string name="format_heading">Heading</string>
    <string name="format_bullet">Bullet list</string>
    <string name="format_quote">Quote</string>
    <string name="format_task">Checkbox</string>
    <string name="format_link">Link</string>

    <!--
      Fallback label for a task overlay whose line has no words yet — "- [ ] " with the caret still
      on it. Normally the task's own text is the contentDescription; an empty one would announce an
      unnamed control, which is worse than a generic name.
    -->
    <string name="task_checkbox">Task</string>
    <string name="editor_expand_section">Show %1$s section</string>
    <string name="editor_collapse_section">Hide %1$s section</string>

    <!--
      Phase 8d-d focus mode. Both are contentDescription read aloud. Enter is the trailing toolbar
      glyph; exit is the corner icon shown while focus mode is on (the toolbar, and its enter button,
      are gone by then).
    -->
    <string name="editor_focus">Focus mode</string>
    <string name="editor_focus_exit">Exit focus mode</string>

    <!--
      Phase 8d-b attachment strip. Both are contentDescription read aloud: the add tile names the
      action, each thumbnail names what it is. There is no per-image alt yet, so every thumbnail
      shares one label — the strip's job is "these are the note's images", not describing each.
    -->
    <string name="attachment_add">Add image</string>
    <string name="attachment_image">Attachment</string>
</resources>
