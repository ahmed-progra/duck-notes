<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="duck.db" />
        <include domain="database" path="duck.db-wal" />
        <include domain="database" path="duck.db-shm" />
        <include domain="file" path="attachments/" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/welcome.preferences_pb" />
        <exclude domain="file" path="attachments/.pending/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="duck.db" />
        <include domain="database" path="duck.db-wal" />
        <include domain="database" path="duck.db-shm" />
        <include domain="file" path="attachments/" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/welcome.preferences_pb" />
        <exclude domain="file" path="attachments/.pending/" />
    </device-transfer>
</data-extraction-rules>
